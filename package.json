{
  "private": true,
  "name": "remnote-graph-plugin",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack-dev-server --color --progress --no-open",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "validate": "remnote-plugin validate",
    "build": "npm run validate && shx rm -rf dist PluginZip.zip && cross-env NODE_ENV=production webpack --color && cd dist && bestzip ../PluginZip.zip ./*",
    "demo": "esbuild dev/demo.tsx --bundle --jsx=automatic --outdir=dev/demo-build"
  },
  "dependencies": {
    "@remnote/plugin-sdk": "0.0.46",
    "graphology": "^0.25.4",
    "graphology-communities-louvain": "^2.0.1",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "sigma": "^3.0.2"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@types/node": "^22.12.0",
    "@types/react": "^17.0.94",
    "@types/react-dom": "^17.0.26",
    "autoprefixer": "^10.7.0",
    "bestzip": "^2.2.7",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "glob": "^14.0.6",
    "graphology-types": "^0.24.8",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.33",
    "postcss-import": "^14.1.0",
    "postcss-loader": "^7.3.4",
    "react-refresh": "^0.14.2",
    "shx": "^0.3.4",
    "style-loader": "^3.3.4",
    "typescript": "~5.6",
    "vitest": "^5.1.1",
    "webpack": "^5.113.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  }
}
